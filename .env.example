# ==========================================
# The Lenny Growth Assistant - Configuration
# ==========================================

# --- Application & Server ---
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# --- Database (PostgreSQL) ---
# For local Docker / Postgres:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lenny_assistant
# Fallback SQLite for lightweight testing:
# DATABASE_URL=sqlite+aiosqlite:///./lenny_assistant.db

# --- Local LLM (Ollama - Mandatory Demo Provider) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
DEFAULT_LLM_PROVIDER=ollama

# --- Cloud LLM Providers (Optional / Fallback) ---
# Leave blank to use Ollama exclusively (Zero cost / No credit card)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
CLOUD_MODEL=claude-3-5-sonnet-20241022

# --- Knowledge & RAG Configuration ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_DB_DIR=./data/chroma
SIMILARITY_THRESHOLD=0.60
TOP_K_CHUNKS=3
